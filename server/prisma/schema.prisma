generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  FINANCIAL_MISCONDUCT
  HARASSMENT
  DATA_PRIVACY
  SAFETY
  POLICY_VIOLATION
  FRAUD
  CONFLICT_OF_INTEREST
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  SUBMITTED
  ACKNOWLEDGED
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum Outcome {
  SUBSTANTIATED
  UNSUBSTANTIATED
  INCONCLUSIVE
}

enum UserRole {
  ETHICS_OFFICER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ETHICS_OFFICER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedReports Report[]   @relation("AssignedOfficer")
  notes           CaseNote[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Report {
  id                     String       @id @default(uuid())
  reportRef              String       @unique
  category               Category
  severity               Severity
  department             String?
  incidentDate           DateTime
  location               String?
  descriptionEncrypted   String
  status                 ReportStatus @default(SUBMITTED)
  isAnonymous            Boolean      @default(true)
  reporterEmailEncrypted String?
  assignedToId           String?
  outcome                Outcome?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  assignedTo User?        @relation("AssignedOfficer", fields: [assignedToId], references: [id])
  files      ReportFile[]
  notes      CaseNote[]
  statusLog  StatusEvent[]
  auditLogs  AuditLog[]

  @@map("reports")
}

model StatusEvent {
  id        String       @id @default(uuid())
  reportId  String
  status    ReportStatus
  note      String?
  createdAt DateTime     @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("status_events")
}

model ReportFile {
  id           String   @id @default(uuid())
  reportId     String
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_files")
}

model CaseNote {
  id        String   @id @default(uuid())
  reportId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@map("case_notes")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  reportId  String?
  action    String
  ip        String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  report Report? @relation(fields: [reportId], references: [id])

  @@map("audit_logs")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  subject   String
  body      String
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}
